# Example nginx server block for the Flutter web build (copy build/web to /var/www/building-fund)
server {
  listen 80;
  server_name _;
  root /var/www/building-fund;
  index index.html;
  gzip on;
  gzip_types text/css application/javascript application/json application/wasm image/svg+xml;
  location / { try_files $uri $uri/ /index.html; }          # SPA fallback for go_router
  location = /flutter_service_worker.js { add_header Cache-Control "no-cache"; }
  location = /index.html { add_header Cache-Control "no-cache"; }
}
